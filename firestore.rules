rules_version = '2';

// Production rules for Tre. Every household is private to its members.
// A signed-in user can:
//   - create exactly one household of their own (the document id must equal their
//     uid, so one per account is enforced by construction, and the payload shape is
//     pinned) with themselves as the sole initial member,
//   - find their household with a members array-contains query on their own uid,
//   - find an invitation with an invitedEmails array-contains query on their own
//     verified email (the client then asks before joining; see HouseholdContext),
//   - read and write a household (and everything under it) only if their uid is in
//     that household's members array,
//   - add their own uid to members if their email was invited (so a partner joins
//     from inside the app), without touching any other field.
// A household holds at most two members. No one outside a household's members (or
// an invited email) can ever read its data.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True when the signed-in user's verified email is invited to this household.
    // Verification matters: an attacker who registers an account claiming someone
    // else's address must not read or join off the unverified claim.
    function isInvited() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in resource.data.get('invitedEmails', []);
    }

    // True when the signed-in user is a member of the household. Guards the get()
    // with exists() so a read racing a not-yet-committed create is denied cleanly
    // (false) instead of raising an evaluation error.
    function isMemberOf(hid) {
      let path = /databases/$(database)/documents/households/$(hid);
      return signedIn() && exists(path) && request.auth.uid in get(path).data.members;
    }

    match /households/{hid} {
      // Direct reads: members and invited users only. There is no read of a
      // non-existent document (discovery happens through the queries below), so a
      // stranger cannot even probe which household ids exist.
      allow get: if signedIn() && (
        request.auth.uid in resource.data.members
        || isInvited()
      );

      // Queries: a user may list only households they belong to or are invited to.
      // Both branches are provable from the client's own query filters (members
      // array-contains their uid, invitedEmails array-contains their verified
      // email), so no query can ever scan other households.
      allow list: if signedIn() && (
        request.auth.uid in resource.data.members
        || isInvited()
      );

      // Create your own household: the id must be your uid (one per account, no id
      // squatting, no creation flood) and you must be the only member, with the
      // payload pinned to the known fields and sane sizes.
      allow create: if signedIn()
        && hid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.keys().hasOnly(['name', 'members', 'memberNames', 'invitedEmails', 'settings', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.get('invitedEmails', []) is list
        && request.resource.data.get('invitedEmails', []).size() <= 2;

      // Members can update, but a household never grows past two members and a
      // member cannot accidentally write themselves out. An invited non-member may
      // only add their own uid to members: their email must be verified, the write
      // touches no field but members, removes no existing member, and adds exactly
      // the caller's own uid and nothing else.
      allow update: if signedIn() && (
        (
          request.auth.uid in resource.data.members
          && request.resource.data.get('members', resource.data.members).size() <= 2
          && request.auth.uid in request.resource.data.get('members', resource.data.members)
        )
        || (
          isInvited()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.removeAll(resource.data.members).hasOnly([request.auth.uid])
          && request.resource.data.members.size() <= 2
        )
      );

      allow delete: if false;

      // Everything in a household's subcollections is readable and writable only by
      // its members. The leading {sub} segment keeps this from matching the household
      // document itself (a recursive {document=**} also matches zero segments, which
      // would let a member's write override the create/delete rules above).
      //
      // The meta docs (plaidStatus, plaidLinkDraft) are maintained only by the Cloud
      // Functions through the Admin SDK, which bypasses these rules. Members may read
      // them (they hold no secrets: sync state and a short-lived Link token), but no
      // client can write them, so the sync status cannot be spoofed from a browser.
      match /{sub}/{document=**} {
        allow read: if isMemberOf(hid);
        allow write: if isMemberOf(hid) && sub != 'meta';
      }
    }

    // Plaid item secrets (the long-lived access token used to read synced balances)
    // live here, outside the household subtree, and are denied to every client. Only
    // the Cloud Functions reach them through the Admin SDK, which bypasses these
    // rules. No browser, member or not, can ever read or write a sync token. Synced
    // balances are written to the household's accounts (above), which members may
    // read; the token itself never leaves the server.
    match /plaidItems/{hid} {
      allow read, write: if false;
    }

    // The resolveProduct URL cache (product names and page prices, no secrets and no
    // household data). Maintained only by the Cloud Function through the Admin SDK;
    // no client ever reads or writes it. Unmatched paths are denied by default; this
    // match just makes the intent explicit.
    match /productCache/{entry} {
      allow read, write: if false;
    }
  }
}
