rules_version = '2';

// Production rules for Tre. The data is private to the household's members.
// A signed-in user can:
//   - create households/primary only with themselves as the sole initial member
//     (the first-run self-bootstrap),
//   - read and write a household (and everything under it) only if their uid is in
//     that household's members array,
//   - add their own uid to members if their email was invited (so a spouse joins by
//     signing in), without touching any other field.
// No one outside the members (or an invited email) can ever read the data.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True when the signed-in user is a member of the household. Guards the get()
    // with exists() so a read racing the first-run parent-absent window is denied
    // cleanly (false) instead of raising an evaluation error.
    function isMemberOf(hid) {
      let path = /databases/$(database)/documents/households/$(hid);
      return signedIn() && exists(path) && request.auth.uid in get(path).data.members;
    }

    match /households/{hid} {
      // A non-existent doc (resource == null) is readable so the first signed-in user
      // can detect the empty state and bootstrap; there is no data to leak when the
      // document does not exist yet.
      allow read: if signedIn() && (
        resource == null
        || request.auth.uid in resource.data.members
        || request.auth.token.email in resource.data.get('invitedEmails', [])
      );

      // Create only with yourself as the only member (the first-run bootstrap).
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid];

      // Members can update freely. An invited non-member may only add their own uid
      // to members: the write touches no field but members, removes no existing
      // member, and adds the caller. This is idempotent and never lets a stranger in.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members
        || (
          request.auth.token.email in resource.data.get('invitedEmails', [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
        )
      );

      allow delete: if false;

      // Everything in a household's subcollections is readable and writable only by
      // its members. The leading {sub} segment keeps this from matching the household
      // document itself (a recursive {document=**} also matches zero segments, which
      // would let a member's write override the create/delete rules above).
      match /{sub}/{document=**} {
        allow read, write: if isMemberOf(hid);
      }
    }

    // Plaid item secrets (the long-lived access token used to read Betterment balances)
    // live here, outside the household subtree, and are denied to every client. Only the
    // Cloud Functions reach them through the Admin SDK, which bypasses these rules. No
    // browser, member or not, can ever read or write a sync token. Synced balances are
    // written to the household's accounts (above), which members may read; the token
    // itself never leaves the server.
    match /plaidItems/{hid} {
      allow read, write: if false;
    }
  }
}
